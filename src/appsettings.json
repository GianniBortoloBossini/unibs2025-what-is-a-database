{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": {
    "Type": "PostgreSQL",
    "Comment": "Cambia 'Type' 'SqlServer' in 'PostgreSQL' o 'SQLite' per cambiare database"
  },
  "ConnectionStrings": {
    "SqlServer": "Server=sqlserver,1433;Database=LibraryDB;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=true;",
    "PostgreSQL": "Host=postgres;Port=5432;Database=LibraryDB;Username=postgres;Password=postgres;",
    "SQLite": "Data Source=/data/library.db"
  }
}